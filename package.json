{
  "name": "kale-miniprogram",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "icons:generate": "node scripts/generate-material-icons.mjs",
    "icons:check": "node scripts/generate-material-icons.mjs --check",
    "test": "vitest run --exclude .worktrees/**",
    "test:coverage": "vitest run --coverage --exclude .worktrees/** && node scripts/check-coverage-contract.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:cloud": "tsc -p tsconfig.cloudfunctions.json",
    "lint": "eslint \"miniprogram/**/*.ts\" \"tests/**/*.{ts,js}\" \"scripts/**/*.mjs\" \"*.mjs\"",
    "lint:cloud": "eslint \"cloudfunctions/**/*.js\"",
    "syntax:cloud": "node scripts/check-cloud-syntax.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:check": "node scripts/check-dependency-risk.mjs",
    "version:check": "node scripts/check-release-version.mjs",
    "resources:check": "node scripts/check-cloud-resources.mjs",
    "resources:deploy": "node scripts/deploy-cloud-resources.mjs",
    "resources:readback": "node scripts/readback-cloud-resources.mjs",
    "migration:capture": "node scripts/capture-migration-evidence.mjs",
    "release:check": "node scripts/check-release-readiness.mjs --state=developer",
    "release:formal": "node scripts/check-release-readiness.mjs --state=formal",
    "line-endings:check": "node scripts/check-line-endings.mjs",
    "package-budget:check": "node scripts/check-miniprogram-budget.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "diff:check": "git diff --check",
    "gate": "npm run format:check && npm run lint && npm run lint:cloud && npm run syntax:cloud && npm run typecheck && npm run typecheck:cloud && npm run test:coverage && npm run icons:check && npm run version:check && npm run resources:check && npm run release:check && npm run security:check && npm run package-budget:check && npm run line-endings:check && npm run secrets:check && npm run diff:check",
    "verify": "npm run gate"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "@types/wechat-miniprogram": "3.4.10",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "prettier": "3.9.5",
    "sharp": "0.34.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vitest": "3.2.7"
  }
}
