<view class="page">
  <view class="topbar">账号设置<text class="en">SETTINGS</text></view>
  <view class="neo-card">
    <view class="section-title">通知偏好<text class="en">[ NOTIFICATIONS ]</text></view><view class="rule" />
    <view class="setting-row"><text>找到可能匹配</text><switch checked="{{preferences.matchFound}}" disabled="{{loading || !!busyKey}}" data-key="matchFound" bindchange="togglePreference" color="#20d6b5" /></view>
    <view class="setting-row"><text>管理员处理结果</text><switch checked="{{preferences.reviewResult}}" disabled="{{loading || !!busyKey}}" data-key="reviewResult" bindchange="togglePreference" color="#20d6b5" /></view>
    <view class="setting-row"><text>已转交官方地点</text><switch checked="{{preferences.officialTransfer}}" disabled="{{loading || !!busyKey}}" data-key="officialTransfer" bindchange="togglePreference" color="#20d6b5" /></view>
    <view class="setting-row"><text>待完成交接</text><switch checked="{{preferences.pickupReminder}}" disabled="{{loading || !!busyKey}}" data-key="pickupReminder" bindchange="togglePreference" color="#20d6b5" /></view>
    <button class="subscribe-button" loading="{{busyKey === 'notifications'}}" disabled="{{loading || !!busyKey}}" bindtap="enableWechatNotifications">允许一次微信服务通知<text class="en">[ ENABLE ]</text></button>
    <view class="notification-tip">微信要求用户主动允许每次订阅；未允许或发送失败时，站内消息仍会保留。</view>
  </view>

  <button class="menu" disabled="{{!!busyKey}}" bindtap="goProfileEdit">申请修改姓名和学号</button>
  <button class="menu" disabled="{{!!busyKey}}" bindtap="goNotice">注意事项与使用规则</button>
  <button class="menu" disabled="{{!!busyKey}}" bindtap="goPrivacy">信息收集与保存说明</button>
  <button class="menu" loading="{{busyKey === 'complaint'}}" disabled="{{!!busyKey}}" bindtap="submitComplaint">举报与投诉</button>
  <button class="menu" loading="{{busyKey === 'clear-cache'}}" disabled="{{!!busyKey}}" bindtap="clearCache">清理旧版本机缓存</button>
  <button class="menu" loading="{{busyKey === 'feedback'}}" disabled="{{!!busyKey}}" bindtap="submitFeedback">意见反馈</button>
  <button class="menu warning" loading="{{busyKey === 'data_deletion'}}" disabled="{{!!busyKey || (deletionRequestStatus && deletionRequestStatus !== 'rejected')}}" bindtap="requestDeletion">申请删除个人数据</button>

  <view class="status-box">
    <view>版本 <text class="number">{{version}}</text></view>
    <view>{{cloudStatus}}</view>
    <view>删除状态：{{deletionStatus}}</view>
    <view class="tip">删除申请经独立审核后进入执行流程；完成后仅保留匿名删除凭证。</view>
  </view>
</view>
