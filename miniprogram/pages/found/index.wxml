<view class="page post-page">
  <view class="topbar">拾卡安全发布<text class="en">FOUND CARD POST</text></view>

  <view wx:if="{{submitted}}" class="neo-card">
    <view class="section-title">发布成功</view>
    <view class="privacy-alert">卡片信息已安全提交。需要时，系统会通过站内消息联系你。</view>
    <button class="neo-button" loading="{{busyKey === 'notifications'}}" disabled="{{!!busyKey}}" bindtap="enableWechatNotifications">开启一次微信服务通知</button>
    <button class="claim-entry" disabled="{{!!busyKey}}" bindtap="publishAnother">继续发布</button>
    <button class="claim-entry" disabled="{{!!busyKey}}" bindtap="goToProfile">查看我的记录</button>
  </view>

  <block wx:else>
    <view class="scan-wrap">
      <view class="scan-box" bindtap="choosePhoto">
        <image wx:if="{{photoPath}}" class="card-preview" mode="aspectFit" src="{{photoPath}}" />
        <block wx:else>
          <view class="scan-corner corner-tl" /><view class="scan-corner corner-tr" />
          <view class="scan-corner corner-bl" /><view class="scan-corner corner-br" />
          <image class="camera-icon" src="/assets/icons/photo-camera.png" mode="aspectFit" />
          <view>点击拍摄校园卡</view><text class="en">ALIGN CARD WITH FRAME</text>
        </block>
      </view>
    </view>
    <view class="privacy-alert">{{photoBusy ? '正在处理照片，请稍候。' : '原图仅用于识别，处理后立即删除，不会公开。'}}</view>

    <text class="label">姓名 <text class="en">[ NAME ON CARD ]</text></text>
    <input class="field" value="{{name}}" disabled="{{!!busyKey || photoBusy}}" placeholder="识别后请核对" bindinput="onName" />
    <text class="label">学号 <text class="en">[ STUDENT ID ON CARD ]</text></text>
    <input class="field" type="number" maxlength="10" value="{{studentNumber}}" disabled="{{!!busyKey || photoBusy}}" placeholder="10位数字" bindinput="onNumber" />
    <text class="label">卡片类别 <text class="en">[ TYPE ]</text></text>
    <picker range="{{cardCategories}}" value="{{categoryIndex}}" disabled="{{!!busyKey || photoBusy}}" bindchange="onCategoryChange"><view class="field picker-field">{{cardCategories[categoryIndex]}}<image class="picker-icon" src="/assets/icons/expand-more.png" mode="aspectFit" /></view></picker>
    <text class="label">校区 <text class="en">[ CAMPUS ]</text></text>
    <picker range="{{campuses}}" range-key="name" value="{{campusIndex}}" disabled="{{!!busyKey || photoBusy}}" bindchange="onCampusChange"><view class="field picker-field">{{campuses[campusIndex].name}}<image class="picker-icon" src="/assets/icons/expand-more.png" mode="aspectFit" /></view></picker>

    <view class="location-panel pickup-panel">
      <view class="section-title">拾取地点<text class="en">[ WHERE YOU FOUND IT ]</text></view><view class="rule" />
      <view class="step-label"><text class="step-number number">1</text>地点类型</view>
      <picker range="{{pickupCategories}}" value="{{pickupCategoryIndex}}" disabled="{{!!busyKey || photoBusy}}" bindchange="onPickupCategoryChange"><view class="field picker-field">{{pickupCategories[pickupCategoryIndex]}}<image class="picker-icon" src="/assets/icons/expand-more.png" mode="aspectFit" /></view></picker>
      <view class="step-label"><text class="step-number number">2</text>具体建筑或区域</view>
      <picker range="{{pickupPlaces}}" value="{{pickupPlaceIndex}}" disabled="{{!!busyKey || photoBusy}}" bindchange="onPickupPlaceChange"><view class="field picker-field">{{pickupPlaces[pickupPlaceIndex]}}<image class="picker-icon" src="/assets/icons/expand-more.png" mode="aspectFit" /></view></picker>
      <view class="step-label"><text class="step-number number">3</text>楼层或区域</view>
      <picker range="{{pickupAreas}}" value="{{pickupAreaIndex}}" disabled="{{!!busyKey || photoBusy}}" bindchange="onPickupAreaChange"><view class="field picker-field">{{pickupAreas[pickupAreaIndex]}}<image class="picker-icon" src="/assets/icons/expand-more.png" mode="aspectFit" /></view></picker>
      <view class="step-label"><text class="step-number number">4</text>具体位置</view>
      <input class="field detail-field" value="{{pickupDetail}}" disabled="{{!!busyKey || photoBusy}}" placeholder="例如：北侧出口旁第三张桌子下" bindinput="onPickupDetail" />
    </view>

    <view class="location-panel storage-panel">
      <view class="section-title">卡片存放地点<text class="en">[ WHERE THE CARD IS NOW ]</text></view><view class="rule" />
      <view class="step-label"><text class="step-number number">1</text>存放地点类型</view>
      <picker range="{{storageCategories}}" value="{{storageCategoryIndex}}" disabled="{{!!busyKey || photoBusy}}" bindchange="onStorageCategoryChange"><view class="field picker-field">{{storageCategories[storageCategoryIndex]}}<image class="picker-icon" src="/assets/icons/expand-more.png" mode="aspectFit" /></view></picker>
      <view class="step-label"><text class="step-number number">2</text>具体建筑或交卡点</view>
      <picker range="{{storagePlaces}}" value="{{storagePlaceIndex}}" disabled="{{!!busyKey || photoBusy}}" bindchange="onStoragePlaceChange"><view class="field picker-field">{{storagePlaces[storagePlaceIndex]}}<image class="picker-icon" src="/assets/icons/expand-more.png" mode="aspectFit" /></view></picker>
      <view class="step-label"><text class="step-number number">3</text>楼层或服务区域</view>
      <picker range="{{storageAreas}}" value="{{storageAreaIndex}}" disabled="{{!!busyKey || photoBusy}}" bindchange="onStorageAreaChange"><view class="field picker-field">{{storageAreas[storageAreaIndex]}}<image class="picker-icon" src="/assets/icons/expand-more.png" mode="aspectFit" /></view></picker>
      <view class="step-label"><text class="step-number number">4</text>具体存放位置</view>
      <input class="field detail-field" value="{{storageDetail}}" disabled="{{!!busyKey || photoBusy}}" placeholder="例如：已交给总服务台工作人员" bindinput="onStorageDetail" />
      <view class="field-tip">身份匹配，且有存放照片或卡片已在官方地点后，失主才能在认领流程中看到领取信息。</view>
      <view class="storage-photo" bindtap="chooseStoragePhoto">
        <image wx:if="{{storagePhotoPath}}" class="storage-preview" src="{{storagePhotoPath}}" mode="aspectFill" />
        <block wx:else><image class="small-camera" src="/assets/icons/add-a-photo.png" mode="aspectFit" /><view>拍摄存放地点周围环境</view><text class="en">[ STORAGE AREA PHOTO · OPTIONAL ]</text></block>
      </view>
    </view>

    <text class="label">拾取日期 <text class="en">[ DATE ]</text></text>
    <picker mode="date" disabled="{{!!busyKey || photoBusy}}" bindchange="onDate"><view class="field picker-field">{{foundDate || '请选择日期'}}<image class="picker-icon" src="/assets/icons/expand-more.png" mode="aspectFit" /></view></picker>
    <text class="label">卡片特点（选填）<text class="en">[ PRIVATE CLUE ]</text></text>
    <textarea class="field feature-field" value="{{feature}}" disabled="{{!!busyKey || photoBusy}}" placeholder="例如：蓝色卡套、背面有贴纸" bindinput="onFeature" />
    <button class="neo-button neo-button--orange submit-button" loading="{{busyKey === 'submit'}}" disabled="{{!!busyKey || photoBusy}}" bindtap="submit">
      <view class="submit-main"><image src="/assets/icons/verified-user-white.png" mode="aspectFit" />确认安全发布</view><text class="en">[ SUBMIT ]</text>
    </button>
  </block>

  <privacy-consent />
</view>
